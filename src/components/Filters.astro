---
// Barra filtri generica: gruppi di "chip" (tema, paese, testata...), ordinamento, "in evidenza". Funziona sugli elementi di #target.
import { t } from '../i18n.js';
const { lang, target, groups = [], sorts = [], featured = false, total = 0 } = Astro.props;
---
<div class="filters" data-filters data-target={target} data-total={total} data-all={t(lang, 'all')} data-none={t(lang, 'noResult')}>
  {groups.map((g) => (
    <div class="fgroup" data-group={g.key}>
      <span class="flabel">{g.label}</span>
      {g.chips.map((c) => <button type="button" class="chip" data-v={c.id} aria-pressed="false">{c.label}<i>{c.count}</i></button>)}
    </div>
  ))}
  <div class="fgroup ftools">
    {sorts.length > 1 && (
      <label class="flabel">{t(lang, 'sort')}
        <select data-sort>{sorts.map((s) => <option value={s.id}>{s.label}</option>)}</select>
      </label>
    )}
    {featured && <button type="button" class="chip" data-featured aria-pressed="false">★ {t(lang, 'featuredOnly')}</button>}
    <button type="button" class="chip reset" data-reset hidden>× {t(lang, 'reset')}</button>
    <span class="fcount" data-count aria-live="polite"></span>
  </div>
</div>
<p class="noresult" data-noresult hidden>{t(lang, 'noResult')}</p>
<script>
  document.querySelectorAll('[data-filters]').forEach((root) => {
    const list = document.querySelector(root.dataset.target);
    const items = [...list.children];
    const state = {};
    let sort = 'original', feat = false;
    const groups = [...root.querySelectorAll('[data-group]')].map((g) => g.dataset.group);
    const noresult = document.querySelector('[data-noresult]');
    const read = () => {
      const h = new URLSearchParams(location.hash.slice(1));
      groups.forEach((k) => { state[k] = new Set((h.get(k) || '').split(',').filter(Boolean)); });
      sort = h.get('sort') || 'original';
      feat = h.get('featured') === '1';
    };
    const write = () => {
      const h = new URLSearchParams();
      groups.forEach((k) => { if (state[k].size) h.set(k, [...state[k]].join(',')); });
      if (sort !== 'original') h.set('sort', sort);
      if (feat) h.set('featured', '1');
      history.replaceState(null, '', h.toString() ? '#' + h : location.pathname + location.search);
    };
    const key = {
      original: (a, b) => a.dataset.order - b.dataset.order,
      recent: (a, b) => (b.dataset.year || 0) - (a.dataset.year || 0) || a.dataset.order - b.dataset.order,
      az: (a, b) => a.dataset.title.localeCompare(b.dataset.title),
    };
    const apply = () => {
      let n = 0;
      items.forEach((it) => {
        let ok = true;
        groups.forEach((k) => {
          if (!state[k].size) return;
          const v = (it.dataset[k] || '').split(' ');
          if (![...state[k]].some((x) => v.includes(x))) ok = false;
        });
        if (feat && it.dataset.featured !== '1') ok = false;
        it.hidden = !ok; if (ok) n++;
      });
      [...items].sort(key[sort] || key.original).forEach((it) => list.appendChild(it));
      root.querySelectorAll('[data-group]').forEach((g) => g.querySelectorAll('.chip').forEach((c) => c.setAttribute('aria-pressed', String(state[g.dataset.group].has(c.dataset.v)))));
      root.querySelector('[data-featured]')?.setAttribute('aria-pressed', String(feat));
      const s = root.querySelector('[data-sort]'); if (s) s.value = sort;
      const active = groups.some((k) => state[k].size) || feat;
      root.querySelector('[data-reset]').hidden = !active;
      root.querySelector('[data-count]').textContent = active ? `${n} / ${items.length}` : '';
      noresult.hidden = n > 0;
    };
    root.addEventListener('click', (e) => {
      const c = e.target.closest('.chip'); if (!c) return;
      if (c.matches('[data-reset]')) { groups.forEach((k) => state[k].clear()); feat = false; }
      else if (c.matches('[data-featured]')) feat = !feat;
      else { const set = state[c.parentElement.dataset.group]; set.has(c.dataset.v) ? set.delete(c.dataset.v) : set.add(c.dataset.v); }
      write(); apply();
    });
    root.querySelector('[data-sort]')?.addEventListener('change', (e) => { sort = e.target.value; write(); apply(); });
    addEventListener('hashchange', () => { read(); apply(); });
    read(); apply();
  });
</script>
